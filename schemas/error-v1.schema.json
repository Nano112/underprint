{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Nano112/underprint/schemas/error-v1.schema.json",
  "title": "Underprint error v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "code", "message"],
  "properties": {
    "schema": { "const": "underprint.error/v1" },
    "code": { "enum": ["invalid_argument", "invalid_input", "unavailable", "unauthorized", "untrusted_evidence", "resource_limit", "algorithm", "internal"] },
    "exit_code": { "type": "integer", "enum": [2, 3, 4, 5, 6, 10] },
    "message": { "type": "string", "minLength": 1 }
  }
}
